  "harness_source": "import sys,json,time,subprocess,copy,hashlib,urllib.error\nfrom pathlib import Path\nimport urllib.request\nROOT=Path('/home/deforest/Documents/DEV/Marathon')\nsys.path[:0]=[str(ROOT/'scripts/routers'),str(ROOT)]\nimport codex_local_router as router\nMODEL='deepseek-v4.1-flash-1017-iq3-s'\nLIVE=Path('/home/deforest/.config/maya-deepseek/config.json')\nHEADERS=router._external_model_profiles()['deepseek-v4.1-flash-1017-maya'].upstream_headers()\ndef req(path,data=None,direct=False,timeout=1200):\n h={} if direct else dict(HEADERS)\n if data is not None:h['Content-Type']='application/json'\n u=('http://127.0.0.1:19241' if direct else 'http://127.0.0.1:9292')+path\n r=urllib.request.Request(u,data=None if data is None else json.dumps(data).encode(),headers=h)\n with urllib.request.urlopen(r,timeout=timeout) as f:\n  b=f.read();return json.loads(b) if b.lstrip().startswith((b'{',b'[')) else b.decode()\ndef status():return req('/v1/status',direct=True,timeout=5)\nOUT=Path(__file__).parent\nBASE=json.loads((OUT/'original.json').read_text())\ndef idle():\n s=status();assert not s['activity']['in_flight'] and not s['activity']['queue']['waiting'],'Active inference; not changing worker'\ndef stop():\n running=req('/running')['running'];assert all(x['model']==MODEL for x in running),'Another registered worker is loaded'\n if running:idle();req('/api/models/unload/'+MODEL,{})\n for _ in range(100):\n  a=subprocess.run(['systemctl','--user','show','maya-deepseek-worker.service','-p','ActiveState','--value'],capture_output=True,text=True).stdout.strip()\n  if a in ('inactive','failed',''):return\n  time.sleep(2)\n raise RuntimeError('Worker did not stop')\ndef configure(name,changes):\n stop();dest=OUT/name;dest.mkdir(exist_ok=True);cfg=copy.deepcopy(BASE)\n for key,value in changes.get('args',{}).items():cfg['args'][cfg['args'].index(key)+1]=str(value)\n cfg['env'].update(changes.get('env',{}));cfg['env']['MAYA_DS4_SLOT_DIR']=str(dest/'slots');(dest/'slots').mkdir(mode=0o700,exist_ok=True)\n cfg['log']=str(dest/'engine.log');(dest/'config.json').write_text(json.dumps(cfg,indent=2)+'\\n');LIVE.write_text(json.dumps(cfg,indent=2)+'\\n');return dest\nCODE='\\n'.join(f'def scale_{i:02d}(value):\\n    return value * {i+2}\\n' for i in range(12))\nEXPECTED=CODE.replace('return value * 7','return value * 9')\nPROMPTS=[('code', 'Write a Python stable topological sort with cycle detection, explain its invariants and give edge-case tests.',384,None),('reasoning','Explain why an LRU cache needs both a dictionary and a doubly linked list, then implement get and put in Python with edge-case tests.',384,None),('copy','Return ONLY the following Python code, changing scale_05 to multiply by 9 instead of 7. Preserve every other function. No Markdown fences or explanation.\\n'+CODE,1024,EXPECTED),('prefill','\\n'.join(f'Record {i:04d}: node_{i} depends on node_{max(0,i-1)}; weight {(i*37)%991}; state healthy.' for i in range(600))+'\\nDescribe checks for this graph and give Python validation code.',384,None),('json','Compute 17*23 and 19*29. Return only this JSON structure with integer values: {\"a\":...,\"b\":...}.',256,{'a':391,'b':551})]\ndef measure(dest,case,prompt,n,expected=None,temp=0):\n idle();t=time.monotonic();response=req('/v1/responses',{'model':MODEL,'input':prompt,'reasoning':{'effort':'high'},'temperature':temp,'max_output_tokens':n,'store':False});elapsed=time.monotonic()-t\n st=status();answer=''.join(c.get('text','') for o in response.get('output',[]) if o.get('type')=='message' for c in o.get('content',[]));ok=None\n if isinstance(expected,str):ok=answer.strip()==expected.strip()\n elif expected is not None:\n  try:ok=json.loads(answer)==expected\n  except ValueError:ok=False\n row={'case':case,'seconds':elapsed,'usage':response.get('usage'),'status':response.get('status'),'timings':st['last_timings'],'answer_sha256':hashlib.sha256(answer.encode()).hexdigest(),'correct':ok}\n (dest/(case+'-response.json')).write_text(json.dumps(response,indent=2));print(json.dumps(row),flush=True);return row\ndef run(name,changes):\n print('START',name,flush=True);dest=configure(name,changes)\n # This request intentionally loads through the broker. No private cache directories are opened.\n t=time.monotonic();req('/v1/responses',{'model':MODEL,'input':'Reply exactly READY.','max_output_tokens':64,'temperature':0,'store':False});(dest/'load.json').write_text(json.dumps({'seconds':time.monotonic()-t}));print('LOADED',name,flush=True)\n rows=[]\n for args in PROMPTS:\n  rows.append(measure(dest,*args));(dest/'results.json').write_text(json.dumps(rows,indent=2))\n print('DONE',name,'seconds',sum(r['seconds'] for r in rows),'correct',[r['correct'] for r in rows],flush=True)\n return rows\nDRAFT=BASE['args'][BASE['args'].index('--pack')+1]+'-dspark'\ndef candidate(maximum=0,cost=False,cum=.5):\n return {'args':{'--pack':DRAFT,'--dspark':'on'},'env':{'MAYA_DS4_DRAFT_DEV':'0,2,3','DS4_DSPARK_MAX':str(maximum),'MAYA_DS4_DRAFT_COST':str(int(cost)),'MAYA_DS4_DSPARK_CUM':str(cum)}}\nCANDIDATES=[('baseline-start',{}),('draft-1',candidate(1)),('draft-2',candidate(2)),('draft-4',candidate(4)),('draft-8',candidate(8)),('draft-8-open',candidate(8,cum=0)),('draft-adaptive',candidate(8,True)),('baseline-end',{})]\nif __name__=='__main__':\n for name,changes in CANDIDATES:\n  run(name,changes)\n print('SCREEN COMPLETE',flush=True)\n",
