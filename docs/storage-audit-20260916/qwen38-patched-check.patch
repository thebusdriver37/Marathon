+constexpr int TOP_K_16_THREADS = 256;
+constexpr int TOP_K_16_SHARDS  = 32;
+
+static __device__ __forceinline__ bool top_k_16_better(
+        const float value_a, const int index_a, const float value_b, const int index_b) {
+    return value_a > value_b || (value_a == value_b && index_a < index_b);
+}
+
+static __device__ __forceinline__ void top_k_16_warp_argmax(float & value, int & index) {
+#pragma unroll
+    for (int offset = WARP_SIZE/2; offset > 0; offset >>= 1) {
+        const float other_value = __shfl_down_sync(0xffffffff, value, offset);
+        const int   other_index = __shfl_down_sync(0xffffffff, index, offset);
+        if (top_k_16_better(other_value, other_index, value, index)) {
+            value = other_value;
+            index = other_index;
+        }
+    }
+}
+
+static __device__ __forceinline__ void top_k_16_block_argmax(
+        float & value, int & index, float * warp_values, int * warp_indices) {
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+
+    top_k_16_warp_argmax(value, index);
+    if (lane == 0) {
+        warp_values [warp] = value;
+        warp_indices[warp] = index;
+    }
+    __syncthreads();
+
+    if (warp == 0) {
+        constexpr int nwarps = TOP_K_16_THREADS/WARP_SIZE;
+        value = lane < nwarps ? warp_values [lane] : -INFINITY;
+        index = lane < nwarps ? warp_indices[lane] : INT_MAX;
+        top_k_16_warp_argmax(value, index);
+    }
+}
+
+// Select the best 16 values in each vocabulary shard. Re-scanning a shard for
+// each rank trades redundant reads for a compact, deterministic implementation;
+// the 32 shards provide enough independent blocks to saturate sm_86.
+static __global__ void top_k_16_stage1(
+        const float * __restrict__ src,
+        float       * __restrict__ tmp_values,
+        int         * __restrict__ tmp_indices,
+        const int ncols) {
+    constexpr int k = 16;
+    __shared__ float warp_values [TOP_K_16_THREADS/WARP_SIZE];
+    __shared__ int   warp_indices[TOP_K_16_THREADS/WARP_SIZE];
+    __shared__ int   selected[k];
+
+    const int row = blockIdx.y;
+    const int shard_size = (ncols + TOP_K_16_SHARDS - 1) / TOP_K_16_SHARDS;
+    const int begin = blockIdx.x*shard_size;
+    const int end   = min(ncols, begin + shard_size);
+    const float * row_src = src + int64_t(row)*ncols;
+
+#pragma unroll
+    for (int rank = 0; rank < k; ++rank) {
+        float best_value = -INFINITY;
+        int   best_index = INT_MAX;
+        for (int i = begin + threadIdx.x; i < end; i += blockDim.x) {
+            bool already_selected = false;
+#pragma unroll
+            for (int previous = 0; previous < rank; ++previous) {
+                already_selected |= selected[previous] == i;
+            }
+            const float value = row_src[i];
+            if (!already_selected && top_k_16_better(value, i, best_value, best_index)) {
+                best_value = value;
+                best_index = i;
+            }
+        }
+
+        top_k_16_block_argmax(best_value, best_index, warp_values, warp_indices);
+        if (threadIdx.x == 0) {
+            selected[rank] = best_index;
+            const int out = (row*TOP_K_16_SHARDS + blockIdx.x)*k + rank;
+            tmp_values [out] = best_value;
+            tmp_indices[out] = best_index;
+        }
+        __syncthreads();
+    }
+}
+
+static __global__ void top_k_16_stage2(
+        const float * __restrict__ tmp_values,
+        const int   * __restrict__ tmp_indices,
+        int         * __restrict__ dst) {
+    constexpr int k = 16;
+    constexpr int ncandidates = TOP_K_16_SHARDS*k;
+    __shared__ float warp_values [TOP_K_16_THREADS/WARP_SIZE];
+    __shared__ int   warp_indices[TOP_K_16_THREADS/WARP_SIZE];
+    __shared__ int   selected[k];
+
+    const int row = blockIdx.x;
+    const float * row_values  = tmp_values  + row*ncandidates;
+    const int   * row_indices = tmp_indices + row*ncandidates;
+
+#pragma unroll
+    for (int rank = 0; rank < k; ++rank) {
+        float best_value = -INFINITY;
+        int   best_index = INT_MAX;
+        for (int i = threadIdx.x; i < ncandidates; i += blockDim.x) {
+            const int index = row_indices[i];
+            bool already_selected = false;
+#pragma unroll
+            for (int previous = 0; previous < rank; ++previous) {
+                already_selected |= selected[previous] == index;
+            }
+            const float value = row_values[i];
+            if (!already_selected && top_k_16_better(value, index, best_value, best_index)) {
+                best_value = value;
+                best_index = index;
+            }
+        }
+
+        top_k_16_block_argmax(best_value, best_index, warp_values, warp_indices);
+        if (threadIdx.x == 0) {
+            selected[rank] = best_index;
+            dst[row*k + rank] = best_index;
+        }
+        __syncthreads();
+    }
+}
+
+static void top_k_16_sm86(
+        ggml_cuda_pool & pool,
+        const float * src,
+        int * dst,
+        const int ncols,
+        const int nrows,
+        cudaStream_t stream) {
+    constexpr int ncandidates = TOP_K_16_SHARDS*16;
+    ggml_cuda_pool_alloc<float> tmp_values (pool, int64_t(nrows)*ncandidates);
+    ggml_cuda_pool_alloc<int>   tmp_indices(pool, int64_t(nrows)*ncandidates);
+
+    top_k_16_stage1<<<dim3(TOP_K_16_SHARDS, nrows, 1), TOP_K_16_THREADS, 0, stream>>>(
+        src, tmp_values.ptr, tmp_indices.ptr, ncols);
+    top_k_16_stage2<<<nrows, TOP_K_16_THREADS, 0, stream>>>(tmp_values.ptr, tmp_indices.ptr, dst);
+}
