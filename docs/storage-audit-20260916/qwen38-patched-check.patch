+bool llama_model_dflash_prepare_mrope(llama_model * draft, const llama_model * target) {
+    if (!draft || !target || draft->arch != LLM_ARCH_DFLASH || draft->hparams.dsv4_hc_mult > 0) {
+        return false;
+    }
+    const auto target_rope = llama_model_rope_type(target);
+    if (target_rope != LLAMA_ROPE_TYPE_MROPE && target_rope != LLAMA_ROPE_TYPE_IMROPE) {
+        return false;
+    }
+    if (llama_model_rope_type(draft) == LLAMA_ROPE_TYPE_MROPE) {
+        return true;
+    }
+    auto & hp = draft->hparams;
+    const uint32_t n_rot = hp.n_rot();
+    if (llama_model_rope_type(draft) != LLAMA_ROPE_TYPE_NEOX || n_rot == 0 || n_rot % 2 != 0) {
+        return false;
+    }
+    for (uint32_t il = 1; il < hp.n_layer(); ++il) {
+        if (hp.n_rot(il) != n_rot) {
+            return false;
+        }
+    }
+    // One temporal section is mathematically the original NeoX rotation. The
+    // four-row layout also permits the overlapping positions of image tokens.
+    hp.rope_sections = {int(n_rot / 2), 0, 0, 0};
+    hp.rope_type = LLAMA_ROPE_TYPE_MROPE;
+    LLAMA_LOG_INFO("%s: using temporal-only M-RoPE for the multimodal DFlash target\n", __func__);
+    return true;
+}
+
+uint32_t llama_model_dflash_seed_window(const llama_model * draft) {
+    if (!draft || draft->arch != LLM_ARCH_DFLASH || draft->hparams.dsv4_hc_mult > 0) {
+        return 0;
+    }
+    for (uint32_t il = 0; il < draft->hparams.n_layer(); ++il) {
+        if (!draft->hparams.is_swa(il)) { return 0; }
+    }
+    return draft->hparams.n_swa;
+}
