+static constexpr const char * SLOT_DRAFT_STATE_SUFFIX = ".draft";
+static constexpr const char * SLOT_SPEC_STATE_SUFFIX  = ".spec";
+static constexpr uint32_t SLOT_SPEC_STATE_MAGIC       = 0x53504331; // SPC1
+static constexpr uint32_t SLOT_SPEC_STATE_VERSION     = 1;
+static constexpr const char * SLOT_CHECKPOINT_SUFFIX  = ".checkpoints";
+
+static void slot_checkpoint_hash(uint64_t & hash, const char * data, size_t size) {
+    hash = XXH64(data, size, hash);
+}
+
+static size_t save_slot_checkpoints(const std::string & filepath, const std::vector<char> & packed,
+        const std::list<common_prompt_checkpoint> & checkpoints) {
+    std::ofstream file(filepath, std::ios::binary | std::ios::trunc);
+    uint64_t hash = 0;
+    size_t written = 0;
+    const auto write = [&](const void * data, size_t size) {
+        file.write(static_cast<const char *>(data), size);
+        slot_checkpoint_hash(hash, static_cast<const char *>(data), size);
+        written += size;
+    };
+    const uint32_t magic = 0x43504331; // CPC1
+    const uint32_t version = 1;
+    const uint64_t packed_size = packed.size();
+    const uint64_t count = checkpoints.size();
+    write(&magic, sizeof(magic));
+    write(&version, sizeof(version));
+    write(&packed_size, sizeof(packed_size));
+    write(&count, sizeof(count));
+    write(packed.data(), packed.size());
+    for (const auto & checkpoint : checkpoints) {
+        write(&checkpoint.n_tokens, sizeof(checkpoint.n_tokens));
+        write(&checkpoint.pos_min, sizeof(checkpoint.pos_min));
+        write(&checkpoint.pos_max, sizeof(checkpoint.pos_max));
+        for (const auto * data : { &checkpoint.data_tgt, &checkpoint.data_dft, &checkpoint.data_spec }) {
+            const uint64_t size = data->size();
+            write(&size, sizeof(size));
+            write(data->data(), data->size());
+        }
+    }
+    file.write(reinterpret_cast<const char *>(&hash), sizeof(hash));
+    file.close();
+    return file ? written + sizeof(hash) : 0;
+}
+
+static size_t load_slot_checkpoints(const std::string & filepath, const llama_tokens & packed,
+        size_t n_tokens, llama_pos pos_next, int max_count, bool has_draft,
+        std::list<common_prompt_checkpoint> & checkpoints) {
+    // Old snapshots have no sidecar. They still restore, but cannot rewind recurrent state.
+    if (!std::filesystem::exists(filepath)) {
+        return 0;
+    }
+    std::ifstream file(filepath, std::ios::binary | std::ios::ate);
+    const auto end = file.tellg();
+    if (!file || end < 32) {
+        throw std::runtime_error("Invalid slot checkpoint file");
+    }
+    uint64_t remaining = static_cast<uint64_t>(end) - sizeof(uint64_t);
+    uint64_t hash = 0;
+    file.seekg(0);
+    const auto read = [&](void * data, size_t size) {
+        if (size > remaining || !file.read(static_cast<char *>(data), size)) {
+            throw std::runtime_error("Truncated slot checkpoint file");
+        }
+        remaining -= size;
+        slot_checkpoint_hash(hash, static_cast<const char *>(data), size);
+    };
+    uint32_t magic, version;
+    uint64_t packed_size, count;
+    read(&magic, sizeof(magic));
+    read(&version, sizeof(version));
+    read(&packed_size, sizeof(packed_size));
+    read(&count, sizeof(count));
+    if (magic != 0x43504331 || version != 1 || packed_size != packed.size()*sizeof(llama_token) || packed_size > remaining) {
+        throw std::runtime_error("Incompatible slot checkpoint file");
+    }
+    llama_tokens stored(packed.size());
+    read(stored.data(), packed_size);
+    constexpr size_t checkpoint_header_size = sizeof(int64_t) + 2*sizeof(llama_pos) + 3*sizeof(uint64_t);
+    if (stored != packed || count > remaining/checkpoint_header_size) {
+        throw std::runtime_error("Slot checkpoints do not match the saved prompt");
+    }
+    std::list<common_prompt_checkpoint> restored;
+    int64_t previous_tokens = 0;
+    for (uint64_t i = 0; i < count; ++i) {
+        common_prompt_checkpoint checkpoint;
+        read(&checkpoint.n_tokens, sizeof(checkpoint.n_tokens));
+        read(&checkpoint.pos_min, sizeof(checkpoint.pos_min));
+        read(&checkpoint.pos_max, sizeof(checkpoint.pos_max));
+        if (checkpoint.n_tokens <= 0 || checkpoint.n_tokens < previous_tokens ||
+                static_cast<uint64_t>(checkpoint.n_tokens) > n_tokens || checkpoint.pos_min < 0 ||
+                checkpoint.pos_max < checkpoint.pos_min || checkpoint.pos_max >= pos_next) {
+            throw std::runtime_error("Invalid slot checkpoint position");
+        }
+        previous_tokens = checkpoint.n_tokens;
+        for (auto * data : { &checkpoint.data_tgt, &checkpoint.data_dft, &checkpoint.data_spec }) {
+            uint64_t size;
+            read(&size, sizeof(size));
+            if (size > remaining || size > SIZE_MAX) {
+                throw std::runtime_error("Invalid slot checkpoint state size");
+            }
+            data->resize(static_cast<size_t>(size));
+            read(data->data(), data->size());
+        }
+        if (checkpoint.empty() || (has_draft && checkpoint.data_dft.empty())) {
+            throw std::runtime_error("Incomplete slot checkpoint state");
+        }
+        // Task IDs do not survive a server restart. Respect the current retention limit.
+        if (count - i <= static_cast<uint64_t>(std::max(0, max_count))) {
+            restored.push_back(std::move(checkpoint));
+        }
+    }
+    uint64_t stored_hash;
+    if (remaining != 0 || !file.read(reinterpret_cast<char *>(&stored_hash), sizeof(stored_hash)) || stored_hash != hash) {
+        throw std::runtime_error("Slot checkpoint checksum mismatch");
+    }
+    checkpoints = std::move(restored);
+    return static_cast<size_t>(end);
+}
+
+static void remove_slot_state_file(const std::string & filepath) {
+    std::error_code error;
+    std::filesystem::remove(filepath, error);
+}
+
+static size_t save_slot_spec_state(
+        const std::string & filepath,
+        common_speculative * spec,
+        llama_seq_id seq_id) {
+    std::vector<uint8_t> data;
+    common_speculative_get_state(spec, seq_id, data);
+
+    std::ofstream file(filepath, std::ios::binary | std::ios::trunc);
+    if (!file) {
+        return 0;
+    }
+
+    const uint64_t size = data.size();
+    file.write(reinterpret_cast<const char *>(&SLOT_SPEC_STATE_MAGIC), sizeof(SLOT_SPEC_STATE_MAGIC));
+    file.write(reinterpret_cast<const char *>(&SLOT_SPEC_STATE_VERSION), sizeof(SLOT_SPEC_STATE_VERSION));
+    file.write(reinterpret_cast<const char *>(&size), sizeof(size));
+    if (!data.empty()) {
+        file.write(reinterpret_cast<const char *>(data.data()), data.size());
+    }
+    file.close();
+
+    return file ? sizeof(SLOT_SPEC_STATE_MAGIC) + sizeof(SLOT_SPEC_STATE_VERSION) + sizeof(size) + data.size() : 0;
+}
+
+static bool load_slot_spec_state(const std::string & filepath, std::vector<uint8_t> & data, size_t & nread) {
+    std::ifstream file(filepath, std::ios::binary | std::ios::ate);
+    if (!file) {
+        return false;
+    }
+
+    const std::streamsize file_size = file.tellg();
+    constexpr size_t header_size = sizeof(uint32_t) * 2 + sizeof(uint64_t);
+    if (file_size < 0 || static_cast<uint64_t>(file_size) < header_size) {
+        return false;
+    }
+    file.seekg(0);
+
+    uint32_t magic = 0;
+    uint32_t version = 0;
+    uint64_t size = 0;
+    file.read(reinterpret_cast<char *>(&magic), sizeof(magic));
+    file.read(reinterpret_cast<char *>(&version), sizeof(version));
+    file.read(reinterpret_cast<char *>(&size), sizeof(size));
+    if (!file || magic != SLOT_SPEC_STATE_MAGIC || version != SLOT_SPEC_STATE_VERSION ||
+            size != static_cast<uint64_t>(file_size) - header_size || size > SIZE_MAX) {
+        return false;
+    }
+
+    data.resize(static_cast<size_t>(size));
+    if (!data.empty()) {
+        file.read(reinterpret_cast<char *>(data.data()), data.size());
+    }
+    if (!file) {
+        return false;
+    }
+
+    nread = static_cast<size_t>(file_size);
+    return true;
+}
