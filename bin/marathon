#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

usage() {
  cat <<USAGE
Usage: marathon [--instance NAME] [command] [args...]

Named instances:
  --instance NAME  Use independent ports, runtime state, logs, cache, and selection

Commands:
  codex           Start the remembered model and open Codex (default)
  dashboard       Open advanced model, profile, frontend, and tuning controls
  setup           Find, add, or download a GGUF model
  hermes          Start Marathon and open Hermes Agent
  direct          Start Marathon and open clean direct chat
  remote HOST     Run a local frontend against HOST's GPUs over SSH
  tune            Open the Dyno machine-specific profile tuner
  models          List discovered GGUF models or add a model folder
  status          Show whether the foreground runtime is active
  stop            Ask an active runtime to stop and free the GPUs
  report [run]    Summarize a telemetry trace (default: latest run)
  compare A B     Compare two telemetry traces
  doctor          Check local setup, backend health, models, ports, GPU, and cache usage
  eval coding     Run a supervised Codex-style coding gauntlet
  resume [ID]     Resume a Marathon session or open its session picker
  fork [ID]       Fork a Marathon session or open its session picker
  exec            Run headless Codex exec against the default local model
  install         Install the marathon command into ~/.local/bin
  search <sub>    Manage SearXNG (up | down | status | check | logs | url | restart | pull)
  setup-deps      Create .marathon/venv and install router Python dependencies
  build           Build patched Marathon binaries
  build-codex     Build the patched local Codex binary
  build-llama     Build the patched local llama.cpp binaries
  setup-llama [upstream|qwen38]  Build a pinned general or optional tuned backend
  update-codex    Fetch the pinned stable Codex, rebase patches, rebuild

Environment:
  MARATHON_AI_ROOT          Models, backends, and cache root (default: ~/AI)
  MARATHON_MODELS_DIR       GGUF model directory (default: ~/AI/models/gguf)
  MARATHON_MODEL_DIRS       OS-path-separated GGUF model directories
  MARATHON_RUNS_DIR         Per-run JSONL trace directory (default: ~/.local/state/marathon/runs)
  MARATHON_TELEMETRY_INTERVAL  GPU/metrics sample interval in seconds (default: 2)
  MARATHON_BACKEND_METRICS_ENABLED  Poll backend /metrics when supported (default: 0)
  MARATHON_TELEMETRY_PROCESS_OUTPUT  Mirror backend/router operational lines (default: 1)
  MARATHON_ELECTRICITY_RATE_USD_KWH  Optional rate for estimated GPU energy cost
  MARATHON_REMOTE_BIN       Marathon executable on the SSH host (default: PATH or ~/.local/bin/marathon)
  MARATHON_SSH_BIN          OpenSSH client executable (default: ssh on PATH)
  MARATHON_HERMES_BIN       Hermes executable (default: hermes on PATH)
  MARATHON_CODEX_BIN        Patched Codex executable and build destination
  MARATHON_CODEX_HOME       Isolated writable Codex home
  MARATHON_STOCK_CODEX_HOME Normal Codex home used for shared user resources
  LLAMACPP_BIN              Exact llama-server binary path
  MARATHON_DS4_GPUS         DS4 pipeline GPU indexes (default: 0,1,2,3)
  MARATHON_DS4_CONTROL_PORT Override DS4's loopback routing-key base
USAGE
}

run_app() {
  local python="$ROOT_DIR/.marathon/venv/bin/python3"
  local requirements="$ROOT_DIR/scripts/requirements.txt"
  local marker="$ROOT_DIR/.marathon/venv/.marathon-requirements"
  local expected
  expected="$(cksum "$requirements")"
  if [[ ! -x "$python" || ! -f "$marker" || "$(cat "$marker")" != "$expected" ]]; then
    echo "First run: preparing Marathon's private Python environment..." >&2
    "$ROOT_DIR/scripts/ops/setup_python_env.sh"
  fi
  PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m marathon_app "$@"
}

instance_args=()
case "${1:-}" in
  --instance)
    if [[ $# -lt 2 || -z "${2:-}" ]]; then
      echo "marathon: --instance requires a name" >&2
      exit 2
    fi
    instance_args=(--instance "$2")
    shift 2
    ;;
  --instance=*)
    instance_name="${1#--instance=}"
    if [[ -z "$instance_name" ]]; then
      echo "marathon: --instance requires a name" >&2
      exit 2
    fi
    instance_args=(--instance "$instance_name")
    shift
    ;;
esac

cmd="${1:-codex}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  dashboard|codex|exec|hermes|direct|remote|remote-host|tune|setup|models|status|stop|report|compare|resume|fork|help|--help|-h|--version|-V)
    ;;
  *)
    if [[ ${#instance_args[@]} -gt 0 ]]; then
      echo "marathon: '$cmd' does not accept --instance" >&2
      exit 2
    fi
    ;;
esac

if [[ "$cmd" == "codex" && "${MARATHON_AUTO_INSTALL_CLI:-1}" == "1" ]]; then
  install_dir="${MARATHON_INSTALL_BIN_DIR:-$HOME/.local/bin}"
  if [[ ! -e "$install_dir/marathon" && ! -L "$install_dir/marathon" ]]; then
    if ! "$ROOT_DIR/scripts/ops/install_cli.sh"; then
      echo "warning: could not install the global launcher; continuing from this checkout" >&2
    fi
  fi
fi

case "$cmd" in
  dashboard)
    run_app "${instance_args[@]}" dashboard "$@"
    ;;
  codex|exec|hermes|direct|remote|remote-host|tune|setup|models|status|stop|report|compare|resume|fork)
    run_app "${instance_args[@]}" "$cmd" "$@"
    ;;
  doctor)
    exec "$ROOT_DIR/scripts/ops/doctor.sh" "$@"
    ;;
  eval)
    subcmd="${1:-}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcmd" in
      coding)
        exec "$ROOT_DIR/scripts/evals/coding_gauntlet.sh" "$@"
        ;;
      help|--help|-h|"")
        cat <<USAGE
Usage: marathon eval <subcommand>

Subcommands:
  coding          Run a temporary Codex-style coding gauntlet
USAGE
        ;;
      *)
        echo "Unknown eval subcommand: $subcmd"
        exit 1
        ;;
    esac
    ;;
  install)
    exec "$ROOT_DIR/scripts/ops/install_cli.sh" "$@"
    ;;
  search)
    exec "$ROOT_DIR/scripts/ops/searxng.sh" "$@"
    ;;
  setup-deps)
    exec "$ROOT_DIR/scripts/ops/setup_python_env.sh" "$@"
    ;;
  build)
    exec "$ROOT_DIR/scripts/build_marathon.sh" "$@"
    ;;
  build-codex)
    exec "$ROOT_DIR/scripts/build_codex.sh" "$@"
    ;;
  build-llama)
    exec "$ROOT_DIR/scripts/build_llamacpp.sh" "$@"
    ;;
  setup-llama)
    exec "$ROOT_DIR/scripts/ops/setup_llamacpp.sh" "$@"
    ;;
  update-codex)
    exec "$ROOT_DIR/scripts/ops/update_codex.sh" "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  --version|-V)
    version="$(sed -n 's/^__version__ = "\([^"]*\)"$/\1/p' "$ROOT_DIR/marathon_app/__init__.py")"
    printf 'Marathon %s\n' "$version"
    ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
