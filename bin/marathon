#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

usage() {
  cat <<USAGE
Usage: marathon [command] [codex args...]

Commands:
  dashboard       Select a model and run Marathon (default)
  codex           Start Marathon and open Codex
  direct          Start Marathon and open clean direct chat
  tune            Open the Dyno machine-specific profile tuner
  models          List centrally installed GGUF models
  status          Show whether the foreground runtime is active
  stop            Ask an active runtime to stop and free the GPUs
  report [run]    Summarize a telemetry trace (default: latest run)
  compare A B     Compare two telemetry traces
  chat            Alias for dashboard (backward compatible)
  backend <sub>   Manage the local router and llama.cpp backend
  doctor          Check local setup, backend health, models, ports, GPU, and cache usage
  eval coding     Run a temporary Codex-style coding gauntlet against the active backend
  resume          Resume a previous Marathon interactive session
  fork            Fork a previous Marathon interactive session
  exec            Run headless Codex exec against the default local model
  install         Install the marathon command into ~/.local/bin
  search <sub>    Manage the SearXNG container (up | down | status | logs | url | restart | pull)
  setup-deps      Create .marathon/venv and install router Python dependencies
  build           Build patched Marathon binaries
  build-codex     Build the patched local Codex binary
  build-llama     Build the patched local llama.cpp binaries
  setup-llama     Clone/build llama.cpp with CUDA
  sweep-128k      Run the focused 128K server config sweep
  update-codex    Fetch latest Codex, rebase patches, rebuild

Environment:
  MARATHON_AI_ROOT          Models, backends, and cache root (default: ~/AI)
  MARATHON_MODELS_DIR       GGUF model directory (default: ~/AI/models/gguf)
  MARATHON_MODEL_PATH       Custom GGUF path for the legacy custom backend command
  MARATHON_MODEL_SLUG       Custom model slug/alias (default: custom)
  MARATHON_MODEL_CONTEXT    Custom model context window (default: 32768)
  MARATHON_RUNS_DIR         Per-run JSONL trace directory (default: ~/.local/state/marathon/runs)
  MARATHON_TELEMETRY_INTERVAL  GPU/metrics sample interval in seconds (default: 2)
  MARATHON_BACKEND_METRICS_ENABLED  Poll llama.cpp /metrics during runs (default: 0)
  MARATHON_TELEMETRY_PROCESS_OUTPUT  Mirror backend/router operational lines (default: 1)
  MARATHON_ELECTRICITY_RATE_USD_KWH  Optional rate for estimated GPU energy cost
  QWEN36_27B_GGUF           Exact Qwen3.6 27B GGUF path
  QWEN36_35B_A3B_GGUF       Exact Qwen3.6 35B A3B GGUF path
  QWOPUS36_35B_A3B_GGUF     Exact Qwopus3.6 35B A3B v1 GGUF path
  GEMMA4_26B_A4B_GGUF       Exact Gemma 4 26B A4B IT GGUF path
  LLAMACPP_BIN              Exact llama-server binary path
USAGE
}

run_app() {
  local python="$ROOT_DIR/.marathon/venv/bin/python3"
  if [[ ! -x "$python" ]]; then
    echo "Marathon's Python environment is missing." >&2
    echo "Run: $ROOT_DIR/bin/marathon setup-deps" >&2
    exit 1
  fi
  PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m marathon_app "$@"
}

cmd="${1:-dashboard}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  dashboard|chat)
    run_app dashboard "$@"
    ;;
  codex|direct|tune|models|status|stop|report|compare)
    run_app "$cmd" "$@"
    ;;
  backend)
    exec "$ROOT_DIR/scripts/ops/backend.sh" "$@"
    ;;
  doctor)
    exec "$ROOT_DIR/scripts/ops/doctor.sh" "$@"
    ;;
  eval)
    subcmd="${1:-}"
    if [[ $# -gt 0 ]]; then
      shift
    fi
    case "$subcmd" in
      coding)
        exec "$ROOT_DIR/scripts/evals/coding_gauntlet.sh" "$@"
        ;;
      help|--help|-h|"")
        cat <<USAGE
Usage: marathon eval <subcommand>

Subcommands:
  coding          Run a temporary Codex-style coding gauntlet
USAGE
        ;;
      *)
        echo "Unknown eval subcommand: $subcmd"
        exit 1
        ;;
    esac
    ;;
  resume)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" resume "$@"
    ;;
  fork)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" fork "$@"
    ;;
  exec)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" exec "$@"
    ;;
  install)
    exec "$ROOT_DIR/scripts/ops/install_cli.sh" "$@"
    ;;
  search)
    exec "$ROOT_DIR/scripts/ops/searxng.sh" "$@"
    ;;
  setup-deps)
    exec "$ROOT_DIR/scripts/ops/setup_python_env.sh" "$@"
    ;;
  build)
    exec "$ROOT_DIR/scripts/build_marathon.sh" "$@"
    ;;
  build-codex)
    exec "$ROOT_DIR/scripts/build_codex.sh" "$@"
    ;;
  build-llama)
    exec "$ROOT_DIR/scripts/build_llamacpp.sh" "$@"
    ;;
  setup-llama)
    exec "$ROOT_DIR/scripts/ops/setup_llamacpp.sh" "$@"
    ;;
  sweep-128k)
    exec "$ROOT_DIR/scripts/benchmarks/qwen36_128k_server_sweep.py" "$@"
    ;;
  update-codex)
    exec "$ROOT_DIR/scripts/ops/update_codex.sh" "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
