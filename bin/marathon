#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<USAGE
Usage: marathon [command] [codex args...]

Commands:
  chat            Launch the default local Codex TUI (default)
  128k            Launch Qwen3.6 27B Q4 128K
  fast            Launch Qwen3.6 27B Q4 32K
  a3b             Launch Qwen3.6 35B A3B
  resume          Resume a previous Marathon interactive session
  fork            Fork a previous Marathon interactive session
  exec            Run headless Codex exec against the default local model
  search <sub>    Manage the SearXNG container (up | down | status | logs | url | restart | pull)
  setup-deps      Create .marathon/venv and install router Python dependencies
  build           Build patched Marathon binaries
  build-codex     Build the patched local Codex binary
  build-llama     Build the patched local llama.cpp binaries
  setup-llama     Clone/build llama.cpp with CUDA
  sweep-128k      Run the focused 128K server config sweep
  update-codex    Fetch latest Codex, rebase patches, rebuild

Environment:
  MARATHON_MODELS_DIR       Base directory for GGUF files (default: ~/models)
  QWEN36_27B_GGUF           Exact Qwen3.6 27B GGUF path
  QWEN36_35B_A3B_GGUF       Exact Qwen3.6 35B A3B GGUF path
  LLAMACPP_BIN              Exact llama-server binary path
USAGE
}

cmd="${1:-chat}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  chat)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" "$@"
    ;;
  128k)
    exec "$ROOT_DIR/scripts/launchers/start_128k.sh" "$@"
    ;;
  fast)
    exec "$ROOT_DIR/scripts/launchers/start_fast.sh" "$@"
    ;;
  a3b)
    exec "$ROOT_DIR/scripts/launchers/start_a3b.sh" "$@"
    ;;
  resume)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" resume "$@"
    ;;
  fork)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" fork "$@"
    ;;
  exec)
    exec "$ROOT_DIR/scripts/launchers/start_codex.sh" exec "$@"
    ;;
  search)
    exec "$ROOT_DIR/scripts/ops/searxng.sh" "$@"
    ;;
  setup-deps)
    exec "$ROOT_DIR/scripts/ops/setup_python_env.sh" "$@"
    ;;
  build)
    exec "$ROOT_DIR/scripts/build_marathon.sh" "$@"
    ;;
  build-codex)
    exec "$ROOT_DIR/scripts/build_codex.sh" "$@"
    ;;
  build-llama)
    exec "$ROOT_DIR/scripts/build_llamacpp.sh" "$@"
    ;;
  setup-llama)
    exec "$ROOT_DIR/scripts/ops/setup_llamacpp.sh" "$@"
    ;;
  sweep-128k)
    exec "$ROOT_DIR/scripts/benchmarks/qwen36_128k_server_sweep.py" "$@"
    ;;
  update-codex)
    exec "$ROOT_DIR/scripts/ops/update_codex.sh" "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd"
    usage
    exit 1
    ;;
esac
