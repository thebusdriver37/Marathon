+// Diagnostic SM86 256-wide, 8x8 Q8/Q8 decode staging.
+// Packed 272-byte rows preserve the original quantized bytes and arithmetic.
+template<int nthreads, int nrows>
+static __device__ __forceinline__ void q8_raw_stage(char * dst, const char * src, int stride) {
+    constexpr int row_bytes = 272;
+    const unsigned int base = ggml_cuda_cvta_generic_to_shared(dst);
+    const int tid = threadIdx.y * WARP_SIZE + threadIdx.x;
+    for (int c = tid; c < nrows * (row_bytes/16); c += nthreads) {
+        const int row = c / (row_bytes/16);
+        const int off = (c % (row_bytes/16))*16;
+        cp_async_cg_16<0>(base + row*row_bytes + off, src + int64_t(row)*stride + off);
+    }
+}
+
+template<int DKQ, int nwarps, int nbatch_fa, bool oob_check>
+static __device__ __forceinline__ void flash_attn_ext_load_tile_q8_0(
+        const char * const __restrict__ K_q8,
+        half2      * const __restrict__ tile_K,
+        const int stride_K,
+        const int i_sup) {
+#if defined(AMPERE_MMA_AVAILABLE)
+    static_assert(DKQ % QK8_0 == 0, "bad Q8_0 head size");
+    constexpr int nthreads = nwarps * WARP_SIZE;
+    constexpr int qwords_per_row = DKQ / sizeof(int);
+    constexpr int scales_per_row = DKQ / QK8_0;
+    constexpr int stride_tile_K_q = qwords_per_row + 4;
+
+    int * const tile_K_q = (int *) tile_K;
+    const int tid = WARP_SIZE*threadIdx.y + threadIdx.x;
+
+#pragma unroll
+    for (int idx = tid; idx < nbatch_fa*qwords_per_row; idx += nthreads) {
+        const int i = idx / qwords_per_row;
+        const int kq = idx - i*qwords_per_row;
+        const int ib = kq / QI8_0;
+        const int iq = kq - ib*QI8_0;
+
+        int q = 0;
+        if (!oob_check || i < i_sup) {
+            const block_q8_0 * const row = (const block_q8_0 *) (K_q8 + int64_t(i)*stride_K);
+            ggml_cuda_memcpy_1<sizeof(int), 2>(&q, row[ib].qs + sizeof(int)*iq);
+        }
+        tile_K_q[i*stride_tile_K_q + kq] = q;
+    }
+
+#pragma unroll
+    for (int idx = tid; idx < nbatch_fa*scales_per_row; idx += nthreads) {
+        const int i = idx / scales_per_row;
+        const int ib = idx - i*scales_per_row;
+        half d = __float2half(0.0f);
+        if (!oob_check || i < i_sup) {
+            const block_q8_0 * const row = (const block_q8_0 *) (K_q8 + int64_t(i)*stride_K);
+            d = row[ib].d;
+        }
+        ((half *) (tile_K_q + i*stride_tile_K_q + qwords_per_row))[ib] = d;
+    }
+#else
+    GGML_UNUSED_VARS(K_q8, tile_K, stride_K, i_sup);
+    NO_DEVICE_CODE;
+#endif // defined(AMPERE_MMA_AVAILABLE)
+}
