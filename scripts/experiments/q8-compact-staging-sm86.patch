+// Diagnostic SM86 256-wide, 8x8 Q8/Q8 decode staging.
+// Packed 272-byte rows preserve the original quantized bytes and arithmetic.
+template<int nthreads, int nrows>
+static __device__ __forceinline__ void q8_raw_stage(char * dst, const char * src, int stride) {
+    constexpr int row_bytes = 272;
+    const unsigned int base = ggml_cuda_cvta_generic_to_shared(dst);
+    const int tid = threadIdx.y * WARP_SIZE + threadIdx.x;
+    for (int c = tid; c < nrows * (row_bytes/16); c += nthreads) {
+        const int row = c / (row_bytes/16);
+        const int off = (c % (row_bytes/16))*16;
+        cp_async_cg_16<0>(base + row*row_bytes + off, src + int64_t(row)*stride + off);
     }
 }
 
