# Copy this file to docker/searxng/.env and customise.
# `./bin/marathon search up` will auto-generate `.env` with a fresh secret on first run.

# SearXNG image used by docker compose. Update deliberately; avoid latest.
MARATHON_SEARXNG_IMAGE=searxng/searxng:2026.5.2-aefc3c316

# Bind address — keep on loopback unless you know what you're doing.
MARATHON_SEARXNG_BIND=127.0.0.1

# Host port the router talks to. Keep in sync with MARATHON_SEARXNG_URL in your shell.
MARATHON_SEARXNG_PORT=18093

# Secret key. Generated automatically by `./bin/marathon search up` if missing.
MARATHON_SEARXNG_SECRET=

# uWSGI tuning. Defaults match a single-user local agent.
MARATHON_SEARXNG_WORKERS=2
MARATHON_SEARXNG_THREADS=4
