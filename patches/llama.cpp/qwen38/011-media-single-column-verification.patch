+int32_t llama_kv_cache::get_single_column_n_max(llama_seq_id seq_id, int32_t n_max) const {
+    const uint32_t stream = seq_to_stream.at(seq_id);
+    const auto & cells = v_cells[stream];
+    const uint32_t used = cells.get_used();
+    // Only append-only caches have the same row placement for batched and serial decode.
+    if (other || n_swa || cells.used_max_p1() != used || v_heads[stream] > used) {
+        return 0;
+    }
+    const uint32_t padding = std::max(n_pad, 256u);
+    // Include the anchor token. Do not cross a padded attention extent in one batch.
+    return std::max(0, std::min(n_max, int32_t(padding - used % padding - 1)));
