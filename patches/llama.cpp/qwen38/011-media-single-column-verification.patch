+
+bool llama_supports_single_column_arithmetic(llama_context * ctx) {
+    const auto & model = ctx->get_model();
+    const auto & params = ctx->get_cparams();
+    const auto * hybrid = dynamic_cast<llama_memory_hybrid *>(ctx->get_memory());
+    if (!hybrid || model.arch != LLM_ARCH_QWEN35 || model.type != LLM_TYPE_27B ||
+            model.ftype() != LLAMA_FTYPE_MOSTLY_IQ4_XS || model.n_devices() != 1 ||
+            model.n_gpu_layers() < model.hparams.n_layer() + 1 || params.n_seq_max != 1 ||
+            (model.split_mode() != LLAMA_SPLIT_MODE_LAYER && model.split_mode() != LLAMA_SPLIT_MODE_NONE) ||
+            model.has_tensor_overrides() || !model.loras.empty() ||
+            !params.causal_attn || !params.flash_attn || !params.offload_kqv || !params.op_offload ||
+            hybrid->get_mem_attn()->type_k() != GGML_TYPE_Q8_0 ||
+            hybrid->get_mem_attn()->type_v() != GGML_TYPE_Q8_0) {
+        return false;
+    }
+    auto * dev = model.dev_output();
+    auto * reg = ggml_backend_dev_backend_reg(dev);
+    using supports_t = bool (*)(ggml_backend_dev_t);
+    const auto supports = (supports_t) ggml_backend_reg_get_proc_address(reg,
+            "ggml_backend_supports_single_column_arithmetic");
+    return supports && supports(dev);
+}
