diff --git a/tools/server/server-checkpoint-pool.h b/tools/server/server-checkpoint-pool.h
new file mode 100644
index 000000000..4ff787743
--- /dev/null
+++ b/tools/server/server-checkpoint-pool.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "common.h"
+#include <memory>
+#include <vector>
+
+// Reuse only exclusively owned server-created checkpoint storage. Checkpoints
+// shared with a prompt-cache entry remain immutable. At most two spare buffers
+// are retained per slot, independently of the prompt cache and its clones.
+class server_checkpoint_buffer_pool {
+    bool enabled;
+    std::vector<std::shared_ptr<common_prompt_checkpoint>> buffers;
+public:
+    explicit server_checkpoint_buffer_pool(bool enabled = false) : enabled(enabled) {}
+
+    void recycle(const std::shared_ptr<const common_prompt_checkpoint> & checkpoint) {
+        if (enabled && checkpoint && checkpoint.use_count() == 1 && buffers.size() < 2) {
+            // Both server checkpoint factories allocate non-const objects;
+            // const ownership is used only to enforce reader immutability.
+            buffers.push_back(std::const_pointer_cast<common_prompt_checkpoint>(checkpoint));
+        }
+    }
+
+    std::shared_ptr<common_prompt_checkpoint> acquire() {
+        while (!buffers.empty()) {
+            auto checkpoint = std::move(buffers.back());
+            buffers.pop_back();
+            // Recheck in case a reader acquired ownership before retirement.
+            if (checkpoint.use_count() == 1) {
+                return checkpoint;
+            }
+        }
+        return std::make_shared<common_prompt_checkpoint>();
+    }
+};
diff --git a/tests/test-server-checkpoint-pool.cpp b/tests/test-server-checkpoint-pool.cpp
new file mode 100644
index 000000000..f774ef160
--- /dev/null
+++ b/tests/test-server-checkpoint-pool.cpp
@@ -0,0 +1,57 @@
+#undef NDEBUG
+#include <cassert>
+#include "../tools/server/server-checkpoint-pool.h"
+
+int main() {
+    server_checkpoint_buffer_pool pool(true);
+    auto mutable_checkpoint = std::make_shared<common_prompt_checkpoint>();
+    mutable_checkpoint->data_tgt.resize(4096);
+    mutable_checkpoint->data_tgt[0] = 42;
+    auto * storage = mutable_checkpoint->data_tgt.data();
+    std::shared_ptr<const common_prompt_checkpoint> checkpoint = std::move(mutable_checkpoint);
+    auto clone = checkpoint;
+    pool.recycle(checkpoint);
+    checkpoint.reset();
+    auto fresh = pool.acquire();
+    fresh->data_tgt.resize(4096);
+    fresh->data_tgt[0] = 7;
+    assert(clone->data_tgt[0] == 42); // cached clone was never mutated
+    fresh.reset();
+
+    pool.recycle(clone); // now exclusively owned
+    clone.reset();
+    auto reused = pool.acquire();
+    assert(reused->data_tgt.data() == storage);
+    assert(reused->data_tgt[0] == 42);
+    checkpoint = std::move(reused);
+    pool.recycle(checkpoint);
+    clone = checkpoint; // a late reader prevents reuse at acquisition too
+    checkpoint.reset();
+    fresh = pool.acquire();
+    assert(fresh.get() != clone.get());
+    assert(clone->data_tgt[0] == 42);
+    clone.reset();
+    fresh.reset();
+
+    std::vector<std::weak_ptr<const common_prompt_checkpoint>> retired;
+    for (int i = 0; i < 3; ++i) {
+        checkpoint = std::make_shared<common_prompt_checkpoint>();
+        retired.push_back(checkpoint);
+        pool.recycle(checkpoint);
+        checkpoint.reset();
+    }
+    assert(!retired[0].expired() && !retired[1].expired());
+    assert(retired[2].expired()); // bounded to two spare buffers
+    fresh = pool.acquire();
+    reused = pool.acquire();
+    assert(fresh == retired[1].lock());
+    assert(reused == retired[0].lock());
+
+    server_checkpoint_buffer_pool disabled;
+    checkpoint = std::make_shared<common_prompt_checkpoint>();
+    std::weak_ptr<const common_prompt_checkpoint> weak = checkpoint;
+    disabled.recycle(checkpoint);
+    checkpoint.reset();
+    assert(weak.expired());
+    return 0;
+}
