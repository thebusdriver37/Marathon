+    auto & cells = v_cells[tree_stream];
+    auto & head  = v_heads[tree_stream];
+
+    for (int32_t r = 0; r < tree_n; ++r) {
+        if (keep[r]) {
+            continue;
+        }
+        const uint32_t idx = tree_cells[r];
+        if (!cells.is_empty(idx)) {
+            cells.rm(idx);
+            if (idx < head) {
+                head = idx;
+            }
+        }
+    }
+
+    tree_n    = 0;
+    tree_mask = false;
+
+    return true;
+}
