+bool llama_context::supports_tree_verify() const {
+    // a hybrid memory with recurrent snapshots; only the graph of this architecture gathers the conv taps along the
+    // tree, and the parent reload of the recurrent state is implemented in the CUDA backend for a single device
+    if (dynamic_cast<llama_memory_hybrid *>(memory.get()) == nullptr || cparams.n_rs_seq == 0 ||
+            model.arch != LLM_ARCH_QWEN35 || model.devices.size() != 1) {
+        return false;
+    }
+    for (int il = 0; il < (int) model.hparams.n_layer(); ++il) {
+        ggml_backend_dev_t dev = model.dev_layer(il);
+        if (dev == nullptr || strncmp(ggml_backend_dev_name(dev), "CUDA", 4) != 0) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool llama_context::set_tree_parents(const int32_t * parents, int32_t n) {
+    auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory.get());
+    if (hybrid == nullptr || !supports_tree_verify()) {
+        LLAMA_LOG_ERROR("%s: tree verify needs a single-device qwen35 model with a hybrid memory and recurrent snapshots (n_rs_seq > 0)\n", __func__);
+        return false;
+    }
+    if (parents == nullptr || n < 2 || n > LLAMA_TREE_MAX_ROWS || (uint32_t) n > cparams.n_rs_seq + 1 ||
+            (uint32_t) n > cparams.n_ubatch || parents[0] != -1) {
+        LLAMA_LOG_ERROR("%s: invalid tree (n = %d, n_rs_seq = %u)\n", __func__, n, cparams.n_rs_seq);
+        return false;
+    }
+    for (int32_t i = 1; i < n; ++i) {
+        if (parents[i] < 0 || parents[i] >= i) {
+            LLAMA_LOG_ERROR("%s: invalid parent %d for row %d\n", __func__, parents[i], i);
+            return false;
+        }
+    }
+    tree_state.n = n;
+    tree_state.parents[0] = -1;
+    tree_state.depth[0]   = 0;
+    for (int32_t i = 1; i < n; ++i) {
+        tree_state.parents[i] = parents[i];
+        tree_state.depth[i]   = tree_state.depth[parents[i]] + 1;
+    }
+    cparams.tree        = &tree_state;
+    cparams.tree_verify = true;
+    hybrid->tree_begin(tree_state);
+    return true;
+}
+
+bool llama_context::tree_commit(llama_seq_id seq_id, const int32_t * rows, int32_t n_rows) {
+    auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory.get());
+    return hybrid != nullptr && rows != nullptr && hybrid->tree_commit(seq_id, rows, n_rows);
+}
