+void llm_graph_input_tree::set_input(const llama_ubatch * ubatch) {
+    const int32_t n = (int32_t) ubatch->n_tokens;
+    GGML_ASSERT(tree != nullptr && tree->n == n);
+
+    if (parents) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(parents->buffer));
+        int32_t * data = (int32_t *) parents->data;
+        for (int32_t r = 0; r < n; ++r) {
+            data[r] = tree->parents[r];
+        }
+    }
+
+    if (conv_idx) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(conv_idx->buffer));
+        int32_t * data = (int32_t *) conv_idx->data;
+        // columns: [0, n_conv-1) hold the stored conv state (oldest first), column n_conv-1+r is batch row r.
+        // tap n_conv-1 is the row itself, earlier taps walk up its ancestors and then into the stored state.
+        const int32_t base = n_conv - 1;
+        for (int32_t r = 0; r < n; ++r) {
+            int32_t cur = r; // current ancestor, -k = k steps before the root
+            for (int32_t w = n_conv - 1; w >= 0; --w) {
+                data[r*n_conv + w] = base + cur;
+                cur = cur > 0 ? tree->parents[cur] : cur - 1;
+            }
+        }
+    }
+}
+
+bool llm_graph_input_tree::can_reuse(const llm_graph_params & params) {
+    tree = params.cparams.tree;
+    return params.cparams.tree_verify && tree != nullptr && parents != nullptr && parents->ne[0] == (int64_t) params.ubatch.n_tokens;
+}
