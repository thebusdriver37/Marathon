+template<int DV, int stride_tile, bool swz, int nwarps, int nbatch_fa, bool oob_check>
+static __device__ __forceinline__ void flash_attn_ext_load_tile_V_q8_0(
+        const char * const __restrict__ V_q8,
+        half2      * const __restrict__ tile_V,
+        const int stride_V,
+        const int i_sup) {
+#if defined(AMPERE_MMA_AVAILABLE)
+    static_assert(DV % QK8_0 == 0, "bad Q8_0 head size");
+    constexpr int nthreads = nwarps * WARP_SIZE;
+    constexpr int qwords_per_row = DV / sizeof(int);
+    const int tid = WARP_SIZE*threadIdx.y + threadIdx.x;
+
+#pragma unroll
+    for (int idx = tid; idx < nbatch_fa*qwords_per_row; idx += nthreads) {
+        const int i = idx / qwords_per_row;
+        const int kq = idx - i*qwords_per_row;
+        const int ib = kq / QI8_0;
+        const int iq = kq - ib*QI8_0;
+
+        int q = 0;
+        half d = __float2half(0.0f);
+        if (!oob_check || i < i_sup) {
+            const block_q8_0 * const row = (const block_q8_0 *) (V_q8 + int64_t(i)*stride_V);
+            ggml_cuda_memcpy_1<sizeof(int), 2>(&q, row[ib].qs + sizeof(int)*iq);
+            d = row[ib].d;
+        }
+
+        const int8_t * const q8 = (const int8_t *) &q;
+        const half2 d2 = __half2half2(d);
+        const half2 values[2] = {
+            __hmul2(make_half2(q8[0], q8[1]), d2),
+            __hmul2(make_half2(q8[2], q8[3]), d2),
+        };
+        char * const dst = swz ?
+            (char *) tile_V + ggml_cuda_fattn_smem_swizzle::bytes_rc<stride_tile>(i, 2*kq) :
+            (char *) (tile_V + i*stride_tile + 2*kq);
+        ggml_cuda_memcpy_1<sizeof(values)>(dst, values);
+    }
+#else
+    GGML_UNUSED_VARS(V_q8, tile_V, stride_V, i_sup);
+    NO_DEVICE_CODE;
+#endif // defined(AMPERE_MMA_AVAILABLE)
+}
