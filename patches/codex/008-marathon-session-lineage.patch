+#[tokio::test]
+async fn ignores_sqlite_candidate_from_another_provider() -> color_eyre::Result<()> {
+    let temp_dir = TempDir::new()?;
+    let config = build_config(&temp_dir).await?;
+    let runtime = state_runtime(&config).await?;
+    let thread_id = ThreadId::new();
+    let mut other_provider_config = config.clone();
+    other_provider_config.model_provider_id = "other-provider".to_string();
+    let rollout_path = write_rollout(
+        &other_provider_config,
+        thread_id,
+        "2025-02-01T10:00:00Z",
+        "preview",
+        SessionSource::Cli,
+        ThreadHistoryMode::Legacy,
+    )?;
+    upsert_thread(
+        &runtime,
+        thread_metadata(
+            &other_provider_config,
+            thread_id,
+            rollout_path,
+            "saved-session",
+        ),
+    )
+    .await?;
+
+    let target = lookup_name(&config, "saved-session").await?;
+
+    assert!(target.is_none());
+    Ok(())
+}
