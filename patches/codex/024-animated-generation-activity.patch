+fn is_generation_spinner_frame(frame: char) -> bool {
+    matches!(
+        frame,
+        '⠋' | '⠙' | '⠹' | '⠸' | '⠼' | '⠴' | '⠦' | '⠧' | '⠇' | '⠏'
+    )
+}
