+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn context_percentage_uses_the_full_runtime_window() {
+        for (used, window, expected) in [
+            (8_661, 65_536, 87),
+            (32_768, 131_072, 75),
+            (65_536, 262_144, 75),
+            (262_144, 262_144, 0),
+        ] {
+            let usage = TokenUsage {
+                total_tokens: used,
+                ..TokenUsage::default()
+            };
+
+            assert_eq!(
+                usage.percent_of_context_window_remaining(window),
+                expected
+            );
+        }
+    }
+}
