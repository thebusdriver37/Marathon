+#[test]
+fn local_model_profile_builds_non_fallback_model_info() {
+    let local_models: LocalModelsFile = serde_json::from_str(
+        r#"{
+            "models": [{
+                "slug": "local-coder-128k",
+                "display_name": "Local Coder 128K",
+                "description": "Local model served by llama.cpp.",
+                "context_window": 131072,
+                "auto_compact_token_limit": 115000,
+                "truncation_limit": 110000,
+                "priority": 10
+            }]
+        }"#,
+    )
+    .expect("local models metadata should parse");
+
+    let model = model_info_from_local_profile(local_models.models[0].clone());
+
+    assert_eq!(model.slug, "local-coder-128k");
+    assert_eq!(model.context_window, Some(131_072));
+    assert_eq!(model.max_context_window, Some(131_072));
+    assert_eq!(model.auto_compact_token_limit, Some(115_000));
+    assert_eq!(
+        model.truncation_policy,
+        TruncationPolicyConfig::tokens(110_000)
+    );
+    assert!(!model.used_fallback_model_metadata);
+}
