+pub(crate) fn model_info_from_local_profile(profile: LocalModelProfile) -> ModelInfo {
+    let max_context_window = profile.max_context_window.unwrap_or(profile.context_window);
+    let auto_compact_token_limit = profile
+        .auto_compact_token_limit
+        .unwrap_or(profile.context_window * 9 / 10);
+    let truncation_limit = profile.truncation_limit.unwrap_or(auto_compact_token_limit);
+
+    ModelInfo {
+        slug: profile.slug,
+        display_name: profile.display_name,
+        description: profile.description,
+        default_reasoning_level: None,
+        supported_reasoning_levels: Vec::new(),
+        shell_type: ConfigShellToolType::Default,
+        visibility: profile.visibility,
