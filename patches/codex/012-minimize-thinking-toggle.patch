+#[tokio::test]
+async fn minimize_thinking_slash_command_toggles_prompt_suffix() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.thread_id = Some(ThreadId::new());
+
+    chat.dispatch_command(SlashCommand::MinimizeThinking);
+    assert!(chat.minimize_thinking);
+    let cells = drain_insert_history(&mut rx);
+    let rendered = cells
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(
+        rendered.contains("Minimize thinking is on."),
+        "expected enabled confirmation, got {rendered:?}"
+    );
+
+    chat.submit_user_message(UserMessage::from("Solve this problem."));
+    match next_submit_op(&mut op_rx) {
+        Op::UserTurn { items, .. } => assert_eq!(
+            items,
+            vec![UserInput::Text {
+                text: "Solve this problem.\n\nminimize thinking".to_string(),
+                text_elements: Vec::new(),
+            }]
+        ),
+        other => panic!("expected suffixed user turn, got {other:?}"),
+    }
+
+    chat.dispatch_command(SlashCommand::MinimizeThinking);
+    assert!(!chat.minimize_thinking);
+    chat.submit_user_message(UserMessage::from("Solve normally."));
+    match next_submit_op(&mut op_rx) {
+        Op::UserTurn { items, .. } => assert_eq!(
+            items,
+            vec![UserInput::Text {
+                text: "Solve normally.".to_string(),
+                text_elements: Vec::new(),
+            }]
+        ),
+        other => panic!("expected unsuffixed user turn, got {other:?}"),
+    }
+}
