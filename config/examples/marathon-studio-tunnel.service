[Unit]
Description=Marathon Mac Studio DeepSeek SSH tunnel
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -L 127.0.0.1:11235:127.0.0.1:11234 macstudio@192.168.1.147
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
